{
  "name": "prospero",
  "version": "0.1.29",
  "private": true,
  "main": "apps/main/dist/index.js",
  "description": "Local orchestrator for Claude Code agents — Claude Max OAuth, Anthropic API key, or remote Docker.",
  "author": "Heverson Silva",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HeversonSilva-gif/Prospero.git"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0",
  "lint-staged": {
    "{apps,packages}/**/{src,tests}/**/*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0"
  },
  "type": "module"
}
