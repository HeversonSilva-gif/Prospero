# Dependencies
node_modules/
.pnpm-store/

# Build artifacts
dist/
out/
release/
# Bundled Poppler binaries — fetched at build time by scripts/fetch-poppler.mjs,
# not committed (large; download-in-build per the v0.1.37 decision).
resources/poppler/
# Note: build/ is NOT ignored — it is electron-builder's buildResources
# directory (icons, entitlements.plist). Build OUTPUT goes to release/ above.
.vite/
.turbo/
*.tsbuildinfo
.tsbuild-node/

# IA
.claude

# Runtime data (Spec §14.1)
*.db
*.db-journal
*.db-wal
*.sqlite
*.sqlite3
data/
app-data/
user-data/
logs/
*.log

# Env / secrets (Spec §14.1)
.env
.env.*
!.env.example
*.pem
*.key
.credentials/

# Brainstorm/design artifacts (local-only)
.superpowers/

# Personal notes, specs & plans — kept on the author's machine, not published.
# (Older history still contains docs/; this only stops tracking it going forward.)
docs/
~docs/

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# OS
Thumbs.db
.DS_Store

# Test artifacts
coverage/
playwright-report/
test-results/

# Prospero VPS deployment — secrets & generated state.
# `.env` carries the OAuth token; `users_database.yml` carries the argon2
# password hash; `secrets/` and `data/` are runtime-generated by Authelia.
# None of these belong in source control. (Most are already covered by
# `.env` / `*.sqlite3` above — these explicit rules document intent.)
infra/docker/vps/.env
infra/docker/vps/authelia/users_database.yml
infra/docker/vps/authelia/secrets/
infra/docker/vps/authelia/data/
