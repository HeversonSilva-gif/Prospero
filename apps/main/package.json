{
  "name": "@dashboard-agent/main",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsup --watch --onSuccess \"cross-env RENDERER_URL=http://localhost:5173 electron ./dist/index.js\"",
    "start": "cross-env RENDERER_URL= electron ./dist/index.js",
    "build": "tsup",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dashboard-agent/shared": "workspace:*",
    "better-sqlite3": "^11.3.0",
    "electron": "33.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.19.40",
    "cross-env": "^7.0.3",
    "tsup": "^8.3.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
