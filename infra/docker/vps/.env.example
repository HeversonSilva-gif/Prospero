# Prospero VPS deployment — environment template.
#
# Copy this file to `.env` in the same directory and fill in real values.
# `.env` is gitignored — DO NOT commit it.

# ── Required: at least one of CLAUDE_CODE_OAUTH_TOKEN or ANTHROPIC_API_KEY ──
# OAuth token from `claude setup-token` (run on a desktop where Claude Code
# CLI is logged into your Claude Max subscription, then copy the printed
# token). This is the same auth flow the desktop build uses.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: pay-per-token alternative. The container starts as long as at
# least one of these two is set.
ANTHROPIC_API_KEY=

# ── Required: hostnames + Claude Code version ──
# Public hostname where Prospero will be reachable (Traefik routes to it).
# Must resolve to the VPS and be covered by Let's Encrypt.
PROSPERO_HOST=prospero.example.com

# Public hostname for Authelia's login UI.
AUTHELIA_HOST=auth.example.com

# Pin the Claude Code CLI version inside the image. Use `latest` for
# rolling, or `1.x.y` for reproducible builds.
CLAUDE_CODE_VERSION=latest
